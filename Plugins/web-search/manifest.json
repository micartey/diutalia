{
  "id": "web-search",
  "name": "Web Search",
  "version": "1.1.3",
  "author": "Rigelyon",
  "license": "MIT",
  "description": "Search the Internet from the Launcher.",
  "minDiutaliaVersion": "3.9.0",
  "tags": [
    "Launcher",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "web",
    "defaultSettings": {
      "search_engine": "Google",
      "direct_url": true,
      "show_suggestions": true,
      "max_results": 5
    }
  }
}
