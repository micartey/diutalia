{
  "id": "port-monitor",
  "name": "Port Monitor",
  "version": "1.0.1",
  "minDiutaliaVersion": "3.6.0",
  "author": "adriamartin91",
  "license": "MIT",
  "description": "Monitor listening ports and their processes. Shows TCP/UDP ports with process info and kill functionality.",
  "tags": [
    "Bar",
